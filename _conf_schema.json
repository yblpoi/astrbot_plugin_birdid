{
    "backend_url": {
        "description": "本地识别服务地址",
        "hint": "例如 http://127.0.0.1:8080，服务需与本插件网络互通",
        "type": "string",
        "default": "http://127.0.0.1:8080"
    },
    "api_key": {
        "description": "服务访问密钥",
        "hint": "留空表示服务端未启用鉴权；密钥只保存在 AstrBot 配置中",
        "type": "string",
        "default": ""
    },
    "api_key_header": {
        "description": "密钥请求头名",
        "hint": "与服务端配置保持一致即可",
        "type": "string",
        "default": "api_key"
    },
    "max_in_flight": {
        "description": "并发识别的请求数",
        "hint": "同时处理的请求上限，超出时直接回复繁忙",
        "type": "int",
        "default": 2
    },
    "backend_concurrency": {
        "description": "插件到后端的连接上限",
        "hint": "通常不小于并发识别数",
        "type": "int",
        "default": 4
    },
    "request_timeout_s": {
        "description": "单次识别超时（秒）",
        "hint": "包含排队与推理时间",
        "type": "int",
        "default": 30
    },
    "ffmpeg_path": {
        "description": "ffmpeg 路径",
        "hint": "留空则使用 PATH 中的 ffmpeg，用于把语音转成服务接受的 WAV",
        "type": "string",
        "default": ""
    },
    "retention_days": {
        "description": "归档保留天数",
        "hint": "超过天数的归档批次会被清理",
        "type": "int",
        "default": 7
    },
    "archive_max_mb": {
        "description": "归档体积上限（MB）",
        "hint": "超出后从最旧的批次开始清理",
        "type": "int",
        "default": 2048
    },
    "archive_interval_s": {
        "description": "归档整理间隔（秒）",
        "hint": "后台多久打包并轮转一次",
        "type": "int",
        "default": 900
    }
}